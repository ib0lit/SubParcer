#!/bin/sh /etc/rc.common

START=95
STOP=10

CRON_TMP="/tmp/cron_subparser.tmp"

get_cron_schedule() {
    local interval="$1"
    local ch="$2"
    local cm="$3"

    [ -z "$ch" ] && ch="0"
    [ -z "$cm" ] && cm="0"

    # Срезаем лидирующие нули для безопасного сравнения в Busybox sh
    ch="${ch#0}"; [ -z "$ch" ] && ch="0"
    cm="${cm#0}"; [ -z "$cm" ] && cm="0"

    case "$interval" in
        never|"")
            echo ""
            ;;
        1h)
            echo "0 * * * *"
            ;;
        12h)
            echo "0 */12 * * *"
            ;;
        24h)
            echo "0 0 * * *"
            ;;
        custom_daily)
            echo "${cm} ${ch} * * *"
            ;;
        custom_every_h)
            [ "$ch" -lt 1 ] && ch="1"
            echo "${cm} */${ch} * * *"
            ;;
        *)
            echo ""
            ;;
    esac
}

start() {
    local enabled
    local interval
    local custom_hour
    local custom_minute

    config_load subparser
    config_get enabled settings enabled '0'
    config_get interval settings interval 'never'
    config_get custom_hour settings custom_hour '0'
    config_get custom_minute settings custom_minute '0'

    crontab -l 2>/dev/null | grep -v "subparser.py" | grep -v "subparser-helper.sh bg_sync" > "$CRON_TMP" || true

    if [ "$enabled" = "1" ] && [ "$interval" != "never" ]; then
        local sched
        sched=$(get_cron_schedule "$interval" "$custom_hour" "$custom_minute")
        if [ -n "$sched" ]; then
            echo "$sched /usr/bin/python3 /usr/bin/subparser.py >/dev/null 2>&1" >> "$CRON_TMP"
        fi
    fi

    crontab "$CRON_TMP" 2>/dev/null || true
    rm -f "$CRON_TMP"
    /etc/init.d/cron restart >/dev/null 2>&1 || true
}

stop() {
    crontab -l 2>/dev/null | grep -v "subparser.py" | grep -v "subparser-helper.sh bg_sync" > "$CRON_TMP" || true
    crontab "$CRON_TMP" 2>/dev/null || true
    rm -f "$CRON_TMP"
    /etc/init.d/cron restart >/dev/null 2>&1 || true
}

restart() {
    stop
    start
}