{
    "luci-app-subparser": {
        "description": "Grant access to SubParser RPC methods",
        "read": {
            "file": {
                "/usr/bin/subparser.py": [ "exec" ],
                "/usr/bin/subparser-helper.sh": [ "exec" ],
                "/tmp/subparser_selected.txt": [ "read" ],
                "/tmp/subparser_sync.log": [ "read" ]
            },
            "uci": [ "subparser", "podkop" ]
        },
        "write": {
            "file": {
                "/tmp/subparser_selected.txt": [ "write" ]
            },
            "uci": [ "subparser", "podkop" ],
            "exec": {
                "/usr/bin/subparser-helper.sh": [ "*" ],
                "/etc/init.d/subparser": [ "restart" ]
            }
        }
    }
}