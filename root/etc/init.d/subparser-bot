#!/bin/sh /etc/rc.common

USE_PROCD=1
START=96
STOP=10

start_service() {
    local enabled token chat_id
    enabled=$(uci -q get subparser.settings.enabled)
    token=$(uci -q get subparser.settings.tg_bot_token)
    chat_id=$(uci -q get subparser.settings.tg_chat_id)

    [ "$enabled" = "1" ] || return 0
    [ -n "$token" ] && [ "$token" != "null" ] || return 0
    [ -n "$chat_id" ] && [ "$chat_id" != "null" ] || return 0

    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/bin/subparser-bot.py
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "subparser"
}
